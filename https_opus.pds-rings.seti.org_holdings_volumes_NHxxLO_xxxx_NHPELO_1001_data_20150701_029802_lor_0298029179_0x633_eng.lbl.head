^EXTENSION_ENCODED_FIRST34_IMAGE = ("LOR_0298029179_0X633_ENG.FIT", 59)       
^EXTENSION_IMAGE_DESCRIPTOR_HEADER = ("LOR_0298029179_0X633_ENG.FIT", 60)     
